    "realm": [
      { "name": "app-user", "description": "Base access to hello-world test app" },
      { "name": "app-admin", "description": "Admin access to hello-world test app" }
    ]
  },
  "users": [
    {
      "username": "testuser",
      "email": "testuser@corp.local",
      "firstName": "Test",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "Test12345!", "temporary": false }
      ],
      "realmRoles": ["app-user"]
    },
    {
      "username": "adminuser",
      "email": "adminuser@corp.local",
      "firstName": "Admin",
